  "keyFeatures": [
    "Satellite and drone imagery ingestion and analysis",
    "Vegetation index calculation (NDVI, NDRE, NDWI, etc.)",
    "Crop health and stress detection",
    "Field boundary management",
    "Prescription and variable-rate application maps",
    "Seasonal and historical trend analysis",
    "Customizable alerts and notifications",
    "Integration with farm management systems",
    "REST API for programmatic access",
    "Data export in industry-standard formats"
  ],
  "publicApiSurface": [
    "GET /fields — list and filter registered fields",
    "POST /fields — create a new field with boundary geometry",
    "GET /fields/{id}/imagery — retrieve imagery for a field",
    "GET /fields/{id}/indices — calculate vegetation indices",
    "POST /fields/{id}/reports — generate analysis reports",
    "POST /webhooks — register webhook endpoints for event notifications",
    "GET /imagery/sources — list available satellite/aerial data sources",
    "GET /reports/{id} — retrieve a generated report"
  ]
